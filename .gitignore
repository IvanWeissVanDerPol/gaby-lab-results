# Temporary work directories
.phr_tmp/
*.tmp
*.swp
*~

# SQLite database files (large + binary)
structured_database/*.db
structured_database/*.db-journal
structured_database/*.db-wal
structured_database/*.db-shm
structured_database/*.sqlite

# Large derivative files (regenerable from source)
**/derivatives/

# Re-identification crosswalks (sensitive)
**/crosswalk*.csv
**/crosswalk*.json

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/

# Build artifacts
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node (for dashboard/)
package-lock.json
node_modules/

# Personal notes that shouldn't be public (yet)
private/
NOTES_PERSONALES.md
# === Canonical operator .gitignore (Hermes 2026-09-14) ===
# Installed as the standard .env hardening for all repos across this operator.
# See /opt/data/.gitignore_global for the canonical version (hermes user level).

# Secrets — block ALL of these by default
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json
secrets.yaml
secrets.yml
credentials.json
service-account*.json
*.keystore
*.jks
*.htpasswd
.netrc
.gcloud/
.aws/
.azure/
.gh-token

# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
.venv/
venv/

# Node
node_modules/

# Build artifacts
dist/
build/
.next/

# Databases
*.sqlite3
*.db

# Local-only
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# === End canonical section ===